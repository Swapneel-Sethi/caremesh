# Core
PORT=8080
NODE_ENV=development
APP_ORIGIN=http://localhost:8080
SESSION_SECRET=replace-with-a-long-random-secret
CARE_TIME_ZONE=Asia/Kolkata

# Google Vertex AI / Gemini (optional, deterministic fallback when empty)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# Email reminders (optional, preview outbox when empty)
RESEND_API_KEY=
MAIL_FROM=CareMesh <onboarding@resend.dev>
CARE_TEAM_ALERT_EMAILS=
CRON_SECRET=

# Firestore (optional, demo store held in memory when empty)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI voice medication escalation
# Demo mode: leave CARE_VOICE_ENABLED=false and use the simulator inside the app.
# Real calls: set CARE_VOICE_ENABLED=true plus all three Twilio values below.
CARE_VOICE_ENABLED=false
CARE_VOICE_PROVIDER=twilio
# Public HTTPS origin Twilio can reach, e.g. https://your-preview.vercel.app
# Leave empty to derive it from Vercel forwarded headers.
CARE_VOICE_PUBLIC_ORIGIN=
CARE_VOICE_LANGUAGE=en-IN
CARE_VOICE_MAX_ATTEMPTS=2
CARE_VOICE_AUTO_ESCALATE=true

# Twilio credentials: server only. Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Demo/test recipient number in E.164 format, used only for the seeded
# demo-recipient while Twilio is configured. Real care recipients store their
# own voicePhone and explicit consent in Firestore.
CARE_VOICE_PHONE=
